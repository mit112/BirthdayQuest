rules_version = '2';

// BirthdayQuest Firestore rules.
//
// There are no Cloud Functions. These rules are the entire enforcement layer, so every
// change here needs a corresponding case in firebase-tests/firestore.rules.test.js.
//
// Isolation is by path: all event content lives under events/{eventId}, and membership is
// a document at events/{eventId}/participants/{uid}. A client cannot express a query that
// reaches another occasion's data, because the path does not exist for them.
//
// Joins are authorised against events/{eventId}/private/codes, which ONLY the host can read.
// That location is the whole point: an invite code is a bearer secret, and a secret every
// member can read is not an authorisation factor. Codes used to live on the event document,
// which is member-readable — so any contributor could read the celebrant code, hand it to a
// fresh anonymous uid, and have that impostor claim celebrant and delete every gift. The
// rules below never compare a secret a requester is allowed to read.
//
// Rules-internal get() is PRIVILEGED: it is not subject to these rules. That is what lets a
// joiner's create be validated against a document the joiner cannot read. Pinned by
// 'authorises a join against a document the joiner cannot read' in the test suite.
//
// inviteCodes is a uniqueness registry plus a code -> eventId lookup; anyone may mint an
// entry there, and a forged one buys nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function participantPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid);
    }

    function isMember(eventId) {
      return signedIn() && exists(participantPath(eventId));
    }

    function isHost(eventId) {
      return isMember(eventId) && get(participantPath(eventId)).data.isHost == true;
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // The invite codes, read here rather than off the member-readable event document.
    function codesData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/private/codes).data;
    }

    // Content vs gameplay, used by both challenges and rewards below.
    //
    // `hasOnly` is what makes a field immutable: any key absent from every allow-list
    // cannot be written at all, so isSecret / createdByUserId / fromUserId / createdAt are
    // pinned without a clause of their own.
    function affects(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Author identity is the hinge the whole content/gameplay split turns on. `.get(k, '')`
    // rather than direct access, because documents written before this rule existed carry
    // no author field and direct access on a missing key errors out rather than returning
    // false — which would deny the host too.
    function isAuthorOf(field) {
      return resource.data.get(field, '') == request.auth.uid;
    }

    // Code uniqueness registry and code -> eventId lookup. `get` so a typed code can be
    // resolved to an occasion; `list` never, so codes cannot be enumerated. Nothing here
    // authorises anything — see the participants create rule.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['eventId', 'kind'])
                    && request.resource.data.eventId is string
                    && request.resource.data.kind in ['contributor', 'celebrant'];
      allow update: if false;
      allow delete: if isHost(resource.data.eventId);
    }

    // A user's own index of the occasions they belong to.
    //
    // Create also accepts the event's hostUid, not just membership: occasion creation
    // commits the participant doc and this doc in the same batch, and batched writes are
    // evaluated against committed state, so isMember() is still false at that point.
    //
    // Update is allowed for the owner because the client writes this row with setData, which
    // is an update whenever the row already exists — which it does for anyone the host
    // removed and then re-invited, since no rule lets the host delete the mirror. Denying
    // update bricked rejoin: the participant create succeeded and the mirror write then
    // failed with permission-denied, leaving a member who is told their invite is invalid.
    match /memberships/{uid}/events/{eventId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && (isMember(eventId) || eventData(eventId).hostUid == request.auth.uid);
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /events/{eventId} {
      allow read: if isMember(eventId);
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow delete: if false;

      // hostUid is the root of authority — participant, state, codes and membership creation
      // all resolve it — so it is immutable. Host transfer is not a feature.
      //
      // Host-only, with nothing carved out. The celebrant's one write is to
      // events/{id}/private/codes, not here: keeping every non-host write off this document
      // is what stops a "clear the code" carve-out being aimed at any other field.
      allow update: if isHost(eventId)
                    && request.resource.data.hostUid == resource.data.hostUid;

      // The two invite codes. Host-readable only — this is the fix for the escalation
      // described at the top of this file. A member cannot read this document, so a member
      // cannot harvest the celebrant code; the join rule below compares against it with a
      // privileged rules-internal get() instead.
      match /private/{docId} {
        allow read: if isHost(eventId);

        // Same shape and same gate as state/main: written in the phase-2 batch alongside the
        // host's own participant document, so it cannot depend on membership.
        allow create: if signedIn() && docId == 'codes'
                      && eventData(eventId).hostUid == request.auth.uid;

        // The host may rotate the codes. The one write a non-host may make is the celebrant
        // consuming their own invite by clearing it, which is what makes that code
        // single-use. The celebrant needs `update` but never `read`: diff() is evaluated
        // server-side and does not require the caller to be able to read the document.
        allow update: if (isHost(eventId) && docId == 'codes')
                      || (
                        signedIn()
                        && docId == 'codes'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['celebrantCode'])
                        && request.resource.data.celebrantCode == ''
                        && get(participantPath(eventId)).data.mode == 'celebrant'
                      );

        allow delete: if false;
      }

      // Self-registration. Two legitimate paths, and nothing else:
      //   1. the host bootstrapping their own participant doc right after creating the event
      //   2. an invited joiner presenting a code that matches the one in private/codes
      // The code is checked against private/codes, not against inviteCodes (client-writable)
      // and not against the event document (member-readable). An empty code never matches,
      // so a consumed code cannot be replayed by presenting ''.
      // Rules for batched writes evaluate against committed state, which is why occasion
      // creation is two-phase — see the plan's "Deviations from the spec".
      match /participants/{uid} {
        // Every participant document carries `usedCode` — the invite code its owner
        // presented. Letting members read each other's rows would therefore re-open the
        // exact escalation private/codes closes, one door along: a contributor reads the
        // celebrant's row and harvests the celebrant code from it. So: your own row, or the
        // host's, who holds both codes anyway. The roster is host-only functionality
        // (`AdminViewModel.loadParticipants`), so nothing else needs it.
        allow get: if (signedIn() && request.auth.uid == uid) || isHost(eventId);
        allow list: if isHost(eventId);

        allow create: if signedIn() && request.auth.uid == uid && (
          (
            request.resource.data.isHost == true
            && eventData(eventId).hostUid == request.auth.uid
          ) || (
            request.resource.data.isHost == false
            && request.resource.data.usedCode is string
            && request.resource.data.usedCode != ''
            && eventData(eventId).isOpen == true
            && (
              (
                request.resource.data.mode == 'contributor'
                && codesData(eventId).contributorCode == request.resource.data.usedCode
              ) || (
                request.resource.data.mode == 'celebrant'
                && codesData(eventId).celebrantCode == request.resource.data.usedCode
              )
            )
          )
        );

        // You may rename yourself or change your avatar. You may not grant yourself host,
        // nor switch play mode.
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.isHost == resource.data.isHost
                      && request.resource.data.mode == resource.data.mode;

        allow delete: if isHost(eventId);
      }

      // Split into a gameplay half and a content half. The gameplay list is verbatim the
      // field set `completeChallengeAtomically` writes, and stays open to any member: the two
      // tests that exercise it do so as an ordinary contributor, and narrowing it to the
      // celebrant would break the dare flow. The content half is the host or the challenge's
      // own author, which is what lets a contributor edit their dare and nobody else's.
      match /challenges/{challengeId} {
        allow read: if isMember(eventId);

        // A member may author a secret dare, in their own name only. The host may author
        // either kind. Both stamp themselves as the author, because the update rule above
        // trusts that field.
        allow create: if isMember(eventId)
                      && request.resource.data.createdByUserId == request.auth.uid
                      && (isHost(eventId) || request.resource.data.isSecret == true)
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 120
                      && request.resource.data.description is string
                      && request.resource.data.description.size() <= 2000
                      && request.resource.data.pointValue is int
                      && request.resource.data.pointValue >= 0
                      && request.resource.data.pointValue <= 1000;

        allow update: if isMember(eventId) && (
                        affects(['isCompleted', 'completedAt', 'proofUrl', 'proofType', 'proofText'])
                        || (
                          (isHost(eventId) || isAuthorOf('createdByUserId'))
                          && affects([
                            'title', 'description', 'pointValue', 'difficulty', 'category',
                            'illustrationAsset', 'isDelivered',
                            'optionBTitle', 'optionBDescription'
                          ])
                        )
                      );

        allow delete: if isHost(eventId);
      }

      match /rewards/{rewardId} {
        allow read: if isMember(eventId);
        allow create: if isHost(eventId);
        allow update: if isMember(eventId);
        allow delete: if isHost(eventId);
      }

      // Append-only by design.
      match /timeline/{timelineId} {
        allow read: if isMember(eventId);
        allow create: if isMember(eventId);
        allow update, delete: if false;
      }

      // Created in the same batch as the host's participant doc, so this cannot depend on
      // membership — it is gated on the event's hostUid instead.
      match /state/{stateId} {
        allow read: if isMember(eventId);
        allow create: if signedIn() && stateId == 'main'
                      && eventData(eventId).hostUid == request.auth.uid;
        allow update: if isMember(eventId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
