rules_version = '2';

// BirthdayQuest Firestore rules.
//
// There are no Cloud Functions. These rules are the entire enforcement layer, so every
// change here needs a corresponding case in firebase-tests/firestore.rules.test.js.
//
// Isolation is by path: all event content lives under events/{eventId}, and membership is
// a document at events/{eventId}/participants/{uid}. A client cannot express a query that
// reaches another occasion's data, because the path does not exist for them.
//
// Joins are authorised against the EVENT document, never against inviteCodes. Only the host
// can write the event document, so only the host can set the codes. inviteCodes is a
// uniqueness registry plus a code -> eventId lookup; anyone may mint an entry there, and a
// forged one buys nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function participantPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid);
    }

    function isMember(eventId) {
      return signedIn() && exists(participantPath(eventId));
    }

    function isHost(eventId) {
      return isMember(eventId) && get(participantPath(eventId)).data.isHost == true;
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // Code uniqueness registry and code -> eventId lookup. `get` so a typed code can be
    // resolved to an occasion; `list` never, so codes cannot be enumerated. Nothing here
    // authorises anything — see the participants create rule.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['eventId', 'kind'])
                    && request.resource.data.eventId is string
                    && request.resource.data.kind in ['contributor', 'celebrant'];
      allow update: if false;
      allow delete: if isHost(resource.data.eventId);
    }

    // A user's own index of the occasions they belong to.
    //
    // Create also accepts the event's hostUid, not just membership: occasion creation
    // commits the participant doc and this doc in the same batch, and batched writes are
    // evaluated against committed state, so isMember() is still false at that point.
    match /memberships/{uid}/events/{eventId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && (isMember(eventId) || eventData(eventId).hostUid == request.auth.uid);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /events/{eventId} {
      allow read: if isMember(eventId);
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow delete: if false;

      // hostUid is the root of authority — participant, state and membership creation all
      // resolve it — so it is immutable. Host transfer is not a feature.
      //
      // The host may otherwise edit freely. The one write a non-host may make is the
      // celebrant consuming their own invite code by clearing it, which is what makes that
      // code single-use: the field lives on the document only the host can write.
      allow update: if request.resource.data.hostUid == resource.data.hostUid
                    && (
                      isHost(eventId)
                      || (
                        signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['celebrantCode'])
                        && request.resource.data.celebrantCode == ''
                        && get(participantPath(eventId)).data.mode == 'celebrant'
                      )
                    );

      // Self-registration. Two legitimate paths, and nothing else:
      //   1. the host bootstrapping their own participant doc right after creating the event
      //   2. an invited joiner presenting a code that matches the one on THIS event document
      // The code is checked against the event, not against inviteCodes, because inviteCodes
      // is client-writable. An empty code never matches, so a consumed code cannot be
      // replayed by presenting ''.
      // Rules for batched writes evaluate against committed state, which is why occasion
      // creation is two-phase — see the plan's "Deviations from the spec".
      match /participants/{uid} {
        allow read: if isMember(eventId);

        allow create: if signedIn() && request.auth.uid == uid && (
          (
            request.resource.data.isHost == true
            && eventData(eventId).hostUid == request.auth.uid
          ) || (
            request.resource.data.isHost == false
            && request.resource.data.usedCode is string
            && request.resource.data.usedCode != ''
            && eventData(eventId).isOpen == true
            && (
              (
                request.resource.data.mode == 'contributor'
                && eventData(eventId).contributorCode == request.resource.data.usedCode
              ) || (
                request.resource.data.mode == 'celebrant'
                && eventData(eventId).celebrantCode == request.resource.data.usedCode
              )
            )
          )
        );

        // You may rename yourself or change your avatar. You may not grant yourself host,
        // nor switch play mode.
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.isHost == resource.data.isHost
                      && request.resource.data.mode == resource.data.mode;

        allow delete: if isHost(eventId);
      }

      match /challenges/{challengeId} {
        allow read: if isMember(eventId);
        allow create: if isMember(eventId);
        allow update: if isMember(eventId);
        allow delete: if isHost(eventId);
      }

      match /rewards/{rewardId} {
        allow read: if isMember(eventId);
        allow create: if isHost(eventId);
        allow update: if isMember(eventId);
        allow delete: if isHost(eventId);
      }

      // Append-only by design.
      match /timeline/{timelineId} {
        allow read: if isMember(eventId);
        allow create: if isMember(eventId);
        allow update, delete: if false;
      }

      // Created in the same batch as the host's participant doc, so this cannot depend on
      // membership — it is gated on the event's hostUid instead.
      match /state/{stateId} {
        allow read: if isMember(eventId);
        allow create: if signedIn() && stateId == 'main'
                      && eventData(eventId).hostUid == request.auth.uid;
        allow update: if isMember(eventId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
