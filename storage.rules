rules_version = '2';

// BirthdayQuest Storage rules.
//
// Media is gated on Firestore membership via cross-service rules. Cross-service evaluation
// allows two unique Firestore document lookups per request; repeat lookups of the same
// document are cached and free, so isMember and isCelebrant together cost one read.
//
// eventId is part of the object path specifically so these rules can extract it.

service firebase.storage {
  match /b/{bucket}/o {

    function participantPath(eventId) {
      return /databases/(default)/documents/events/$(eventId)/participants/$(request.auth.uid);
    }

    function isMember(eventId) {
      return request.auth != null && firestore.exists(participantPath(eventId));
    }

    function isCelebrant(eventId) {
      return isMember(eventId)
             && firestore.get(participantPath(eventId)).data.mode == 'celebrant';
    }

    function isHost(eventId) {
      return isMember(eventId)
             && firestore.get(participantPath(eventId)).data.isHost == true;
    }

    // SVG excluded even though it matches image/.*: it is script-bearing, not just pixels,
    // and reward media and challenge proofs are both served back to every member.
    // Anchored pattern, not equality: bare equality misses parameterised variants like
    // "image/svg+xml; charset=utf-8" and unsuffixed "image/svg".
    //
    // Defined once and used by BOTH media paths. It was previously duplicated — the rewards
    // clause and the proofs clause were independently maintained copies of the same
    // exclusion, which is a drift trap: deleting one of them failed no test.
    function isSafeImage() {
      return request.resource.contentType.matches('image/.*')
             && !request.resource.contentType.matches('image/svg.*');
    }

    function isPlayableMedia() {
      return request.resource.contentType.matches('video/.*')
             || request.resource.contentType.matches('audio/.*')
             || isSafeImage();
    }

    // Reward media. Written by contributors, read by members, deleted by the celebrant
    // once downloaded — that client-side delete is what keeps storage bounded.
    //
    // Overwrite (request.resource != null && resource != null) is denied outright, including
    // to the celebrant: without it, any member could destroy a gift/proof before the celebrant
    // ever fetches it just by uploading over the same path, with no delete call needed. Uploads
    // use UUID filenames, so nothing legitimate ever needs to overwrite — delete then re-upload.
    match /events/{eventId}/rewards/{rewardId}/{fileName} {
      allow read: if isMember(eventId);
      allow write: if request.resource == null
                     ? isCelebrant(eventId) || isHost(eventId)
                     : resource == null
                       && isMember(eventId)
                       && request.resource.size < 200 * 1024 * 1024
                       && isPlayableMedia();
    }

    // Challenge proof photos. Images only, 10 MB cap. Same overwrite-denial rationale as above.
    //
    // Delete is the celebrant OR the host. The host is here for exactly one reason: deleting a
    // challenge (host-only moderation) leaves its proof object orphaned forever — no live
    // challenge references it, so the celebrant's expiry sweep never reaches it — and the host's
    // delete path (ChallengeAuthoringViewModel) purges it alongside. That purge reconstructs the
    // proof path from the challengeId and demands equality, the same guard MediaStore uses, so a
    // proofUrl aimed at another object cannot ride along. The accepted cost of this grant: a
    // host can now delete a proof object while leaving the challenge marked complete.
    match /events/{eventId}/proofs/{challengeId}/{fileName} {
      allow read: if isMember(eventId);
      allow write: if request.resource == null
                     ? isCelebrant(eventId) || isHost(eventId)
                     : resource == null
                       && isMember(eventId)
                       && request.resource.size < 10 * 1024 * 1024
                       && isSafeImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
